{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    "sourceMap": false,
    "declaration": false,
    "removeComments": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/tests/**"],
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  }
}

{
  "name": "@auric/core",
  "version": "0.1.0",
  "private": true,
  "description": "AURIC Core — thin, versioned cross-cutting foundation reused across client projects.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": "./core/index.ts",
    "./contracts": "./core/contracts/index.ts"
  },
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register main.ts",
    "serve": "node --import @swc-node/register/esm-register main.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "migrate": "node --import @swc-node/register/esm-register scripts/migrate.ts up",
    "migrate:status": "node --import @swc-node/register/esm-register scripts/migrate.ts status",
    "provision-db": "node --import @swc-node/register/esm-register scripts/provision-db.ts",
    "migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{core,mizan/backend,scripts}/**/*.ts\" \"main.ts\"",
    "format:check": "prettier --check \"{core,mizan/backend,scripts}/**/*.ts\" \"main.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.5",
    "nanoid": "^5.0.9",
    "nodemailer": "^9.0.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.3",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.6",
    "prisma-kysely": "^3.2.1",
    "tsc-alias": "^1.9.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.7"
  }
}

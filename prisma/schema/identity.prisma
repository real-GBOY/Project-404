// core/identity — users, refresh tokens, verification tokens (§7.1).
// Tables created by core/identity/migrations/*; names kept via @@map.

model users {
  id                String    @id
  email             String
  email_normalized  String    @unique @db.Citext
  password_hash     String
  display_name      String?
  /// @kyselyType('active' | 'pending' | 'disabled')
  status            String    @default("pending")
  email_verified_at DateTime? @db.Timestamptz(6)
  locale            String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  refresh_tokens       refresh_tokens[]
  verification_tokens  verification_tokens[]
  user_roles           user_roles[]
  organization_members organization_members[]
  notifications        notifications[]

  @@map("users")
}

model refresh_tokens {
  id         String    @id
  user_id    String
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  /// Set when this token was consumed by a rotation, pointing at its successor.
  rotated_to String?
  user_agent String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "refresh_tokens_user_idx")
  @@map("refresh_tokens")
}

model verification_tokens {
  id          String    @id
  user_id     String
  /// @kyselyType('email_verification' | 'password_reset')
  purpose     String
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, purpose], map: "verification_tokens_user_purpose_idx")
  @@map("verification_tokens")
}

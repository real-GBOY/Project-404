// AURIC Core — Prisma datasource & generators.
//
// Plan §2: Prisma owns the schema definition and migration history; its
// generated types are the source for Kysely's `Database` interface
// (types flow Prisma → Kysely). Prisma Client is NOT used for runtime
// queries — Kysely stays the query builder. See docs/integration-guide.md.
//
// Models live in the sibling *.prisma files in this folder, split by module
// and mirroring the tables (`@@map` / `@map` keep the snake_case names).
// Migrations are in ../migrations, applied with `prisma migrate deploy`.
//
// NOTE: `citext` is created by the baseline migration (CREATE EXTENSION),
// not declared here — `extensions = [citext]` needs the `postgresqlExtensions`
// preview feature, which lives on a `generator client` block, and Core has no
// Prisma Client generator.

datasource db {
  provider = "postgresql"
}

generator kysely {
  provider        = "prisma-kysely"
  output          = "../../core/kernel/db"
  fileName        = "schema.ts"
  importExtension = ".js"
  dbTypeName      = "Database"
  banner          = "import type { Json } from \"./json.js\";"
}

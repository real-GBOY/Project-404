// mizan/backend/app/lawfirm/matters — matters, participants, timeline updates,
// note trail. Client #1's domain (Matters stay client-specific — README §13).

model lawfirm_matters {
  id              String    @id
  organization_id String
  reference       String
  title           String
  client_id       String
  practice_area   String
  /// @kyselyType('open' | 'on_hold' | 'closed')
  status          String    @default("open")
  court           String?
  lead_lawyer_id  String
  opened_at       DateTime  @db.Timestamptz(6)
  closed_at       DateTime? @db.Timestamptz(6)
  description     String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  lawfirm_clients          lawfirm_clients             @relation(fields: [organization_id, client_id], references: [organization_id, id], onDelete: Restrict, onUpdate: NoAction, map: "lawfirm_matters_client_fk")
  lawfirm_matter_participants lawfirm_matter_participants[]
  lawfirm_matter_updates   lawfirm_matter_updates[]
  lawfirm_matter_notes     lawfirm_matter_notes[]
  lawfirm_hearings         lawfirm_hearings[]
  lawfirm_tasks            lawfirm_tasks[]
  lawfirm_documents        lawfirm_documents[]
  lawfirm_invoices         lawfirm_invoices[]
  lawfirm_expenses         lawfirm_expenses[]
  lawfirm_calendar_events  lawfirm_calendar_events[]

  @@unique([organization_id, id], map: "lawfirm_matters_org_id_uq")
  @@unique([organization_id, reference], map: "lawfirm_matters_reference_uq")
  @@index([organization_id], map: "lawfirm_matters_org_idx")
  @@index([organization_id, client_id], map: "lawfirm_matters_client_idx")
  @@index([organization_id, status], map: "lawfirm_matters_status_idx")
  @@map("lawfirm_matters")
}

model lawfirm_matter_participants {
  id              String   @id
  organization_id String
  matter_id       String
  user_id         String
  role            String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  lawfirm_matters lawfirm_matters @relation(fields: [organization_id, matter_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction, map: "lawfirm_matter_participants_matter_fk")

  @@unique([organization_id, matter_id, user_id], map: "lawfirm_matter_participants_uq")
  @@index([organization_id, matter_id], map: "lawfirm_matter_participants_matter_idx")
  @@map("lawfirm_matter_participants")
}

model lawfirm_matter_updates {
  id              String   @id
  organization_id String
  matter_id       String
  author_id       String
  body            String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  lawfirm_matters             lawfirm_matters              @relation(fields: [organization_id, matter_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction, map: "lawfirm_matter_updates_matter_fk")
  lawfirm_matter_update_files lawfirm_matter_update_files[]

  @@unique([organization_id, id], map: "lawfirm_matter_updates_org_id_uq")
  @@index([organization_id, matter_id], map: "lawfirm_matter_updates_matter_idx")
  @@map("lawfirm_matter_updates")
}

model lawfirm_matter_update_files {
  id               String   @id
  organization_id  String
  matter_update_id String
  document_id      String
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  lawfirm_matter_updates lawfirm_matter_updates @relation(fields: [organization_id, matter_update_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction, map: "lawfirm_matter_update_files_update_fk")

  @@index([organization_id, matter_update_id], map: "lawfirm_matter_update_files_update_idx")
  @@map("lawfirm_matter_update_files")
}

model lawfirm_matter_notes {
  id              String   @id
  organization_id String
  matter_id       String
  author_id       String
  body            String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  lawfirm_matters lawfirm_matters @relation(fields: [organization_id, matter_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction, map: "lawfirm_matter_notes_matter_fk")

  @@index([organization_id, matter_id], map: "lawfirm_matter_notes_matter_idx")
  @@map("lawfirm_matter_notes")
}

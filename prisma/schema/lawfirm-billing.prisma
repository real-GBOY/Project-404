// mizan/backend/app/lawfirm/billing — invoices, fee/disbursement lines,
// payments, expenses. Financial calculation is server-authoritative
// (README §6): total = fees + disbursements + VAT − payments;
// payment.currency must equal invoice.currency; no overpayment past balance;
// multi-currency has no FX — per-currency arrays.

model lawfirm_invoices {
  id              String    @id
  organization_id String
  number          String
  client_id       String
  matter_id       String?
  /// @kyselyType('draft' | 'issued' | 'sent' | 'paid' | 'void')
  status          String    @default("draft")
  /// @kyselyType('EGP' | 'AED' | 'USD' | 'SAR')
  currency        String    @default("EGP")
  issued_at       DateTime? @db.Timestamptz(6)
  due_at          DateTime? @db.Timestamptz(6)
  /// @kyselyType(string)
  vat_rate        Decimal   @default(0) @db.Decimal(6, 4)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  lawfirm_clients      lawfirm_clients       @relation(fields: [organization_id, client_id], references: [organization_id, id], onDelete: Restrict, onUpdate: NoAction, map: "lawfirm_invoices_client_fk")
  lawfirm_matters      lawfirm_matters?      @relation(fields: [organization_id, matter_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction, map: "lawfirm_invoices_matter_fk")
  lawfirm_invoice_lines lawfirm_invoice_lines[]
  lawfirm_payments     lawfirm_payments[]

  @@unique([organization_id, id], map: "lawfirm_invoices_org_id_uq")
  @@unique([organization_id, number], map: "lawfirm_invoices_number_uq")
  @@index([organization_id], map: "lawfirm_invoices_org_idx")
  @@index([organization_id, client_id], map: "lawfirm_invoices_client_idx")
  @@index([organization_id, matter_id], map: "lawfirm_invoices_matter_idx")
  @@index([organization_id, status], map: "lawfirm_invoices_status_idx")
  @@map("lawfirm_invoices")
}

model lawfirm_invoice_lines {
  id              String   @id
  organization_id String
  invoice_id      String
  /// @kyselyType('fee' | 'disbursement')
  kind            String
  description     String
  /// @kyselyType(string)
  amount          Decimal  @db.Decimal(14, 2)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  lawfirm_invoices lawfirm_invoices @relation(fields: [organization_id, invoice_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction, map: "lawfirm_invoice_lines_invoice_fk")

  @@index([organization_id, invoice_id], map: "lawfirm_invoice_lines_invoice_idx")
  @@map("lawfirm_invoice_lines")
}

model lawfirm_payments {
  id              String   @id
  organization_id String
  invoice_id      String
  /// @kyselyType(string)
  amount          Decimal  @db.Decimal(14, 2)
  /// @kyselyType('EGP' | 'AED' | 'USD' | 'SAR')
  currency        String
  /// @kyselyType('bank_transfer' | 'cheque' | 'cash' | 'card')
  method          String
  received_at     DateTime @db.Timestamptz(6)
  reference       String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  lawfirm_invoices lawfirm_invoices @relation(fields: [organization_id, invoice_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction, map: "lawfirm_payments_invoice_fk")

  @@index([organization_id, invoice_id], map: "lawfirm_payments_invoice_idx")
  @@index([organization_id, received_at], map: "lawfirm_payments_received_idx")
  @@map("lawfirm_payments")
}

model lawfirm_expenses {
  id              String   @id
  organization_id String
  matter_id       String?
  description     String
  category        String   @default("Disbursement")
  /// @kyselyType(string)
  amount          Decimal  @db.Decimal(14, 2)
  /// @kyselyType('EGP' | 'AED' | 'USD' | 'SAR')
  currency        String   @default("EGP")
  /// @kyselyType('pending' | 'approved' | 'rejected')
  status          String   @default("pending")
  incurred_at     DateTime @db.Timestamptz(6)
  submitted_by_id String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  lawfirm_matters lawfirm_matters? @relation(fields: [organization_id, matter_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction, map: "lawfirm_expenses_matter_fk")

  @@index([organization_id], map: "lawfirm_expenses_org_idx")
  @@index([organization_id, matter_id], map: "lawfirm_expenses_matter_idx")
  @@index([organization_id, status], map: "lawfirm_expenses_status_idx")
  @@map("lawfirm_expenses")
}

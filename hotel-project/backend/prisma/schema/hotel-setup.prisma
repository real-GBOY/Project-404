// app/hotel — property setup: hotel settings, room types, rooms, guests (+ notes).
// Mirrors migration 20260927130000_hotel_setup for Kysely type generation only; the SQL is the
// source of truth for constraints, triggers and RLS. Every row is tenant-scoped.

model hotel_settings {
  organization_id String   @id
  hotel_name      String
  time_zone       String   @default("Africa/Cairo")
  /// @kyselyType('EGP')
  currency        String   @default("EGP")
  /// "HH:MM", hotel-local
  check_in_time   String   @default("14:00")
  /// "HH:MM", hotel-local
  check_out_time  String   @default("12:00")
  tax_rate        Decimal  @default(0.14) @db.Decimal(5, 4)
  address         String?
  phone           String?
  email           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("hotel_settings")
}

model hotel_room_types {
  id              String    @id
  organization_id String
  code            String
  name            String
  description     String?
  capacity        Int
  beds            String
  base_rate       Decimal   @db.Decimal(12, 2)
  /// @kyselyType(Json<string[]>)
  amenities       Json      @default("[]")
  sort_order      Int       @default(0)
  archived_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  hotel_rooms hotel_rooms[]

  @@unique([organization_id, id], map: "hotel_room_types_org_id_uq")
  @@unique([organization_id, code], map: "hotel_room_types_code_uq")
  @@index([organization_id, sort_order, name], map: "hotel_room_types_list_idx")
  @@map("hotel_room_types")
}

model hotel_rooms {
  id                  String    @id
  organization_id     String
  number              String
  floor               Int
  room_type_id        String
  /// @kyselyType('clean' | 'dirty' | 'cleaning' | 'inspected')
  housekeeping_status String    @default("clean")
  /// @kyselyType('in_service' | 'maintenance' | 'out_of_service')
  service_status      String    @default("in_service")
  notes               String?
  archived_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  hotel_room_types hotel_room_types @relation(fields: [organization_id, room_type_id], references: [organization_id, id], onDelete: Restrict, onUpdate: NoAction, map: "hotel_rooms_room_type_fk")

  @@unique([organization_id, id], map: "hotel_rooms_org_id_uq")
  @@unique([organization_id, number], map: "hotel_rooms_number_uq")
  @@index([organization_id, room_type_id], map: "hotel_rooms_type_idx")
  @@map("hotel_rooms")
}

model hotel_guests {
  id                 String   @id
  organization_id    String
  full_name          String
  phone              String?
  email              String?
  /// ISO 3166-1 alpha-2
  nationality        String?
  /// @kyselyType('national_id' | 'passport' | null)
  id_document_type   String?
  id_document_number String?
  preferences        String?
  vip                Boolean  @default(false)
  created_by         String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  hotel_guest_notes hotel_guest_notes[]

  @@unique([organization_id, id], map: "hotel_guests_org_id_uq")
  @@index([organization_id, phone], map: "hotel_guests_phone_idx")
  @@map("hotel_guests")
}

model hotel_guest_notes {
  id              String   @id
  organization_id String
  guest_id        String
  author_id       String
  body            String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  hotel_guests hotel_guests @relation(fields: [organization_id, guest_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction, map: "hotel_guest_notes_guest_fk")

  @@index([organization_id, guest_id, created_at], map: "hotel_guest_notes_guest_idx")
  @@map("hotel_guest_notes")
}

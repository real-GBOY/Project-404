// app/hotel — front desk: folio charges, payments, invoices (+ frozen items), housekeeping tasks.
// Mirrors migration 20260929120000_hotel_front_desk for Kysely type generation only.

model hotel_folio_charges {
  id              String    @id
  organization_id String
  reservation_id  String
  /// @kyselyType('room' | 'breakfast' | 'extra_bed' | 'minibar' | 'laundry' | 'transfer' | 'service')
  kind            String
  description     String
  service_date    DateTime  @db.Date
  quantity        Int
  unit_price      Decimal   @db.Decimal(12, 2)
  amount          Decimal   @db.Decimal(12, 2)
  tax_amount      Decimal   @db.Decimal(12, 2)
  invoice_id      String?
  voided_at       DateTime? @db.Timestamptz(6)
  void_reason     String?
  created_by      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, id], map: "hotel_folio_charges_org_id_uq")
  @@index([organization_id, reservation_id], map: "hotel_folio_charges_reservation_idx")
  @@map("hotel_folio_charges")
}

model hotel_payments {
  id                 String    @id
  organization_id    String
  reservation_id     String
  invoice_id         String?
  /// @kyselyType('cash' | 'card' | 'bank_transfer' | 'online')
  method             String
  amount             Decimal   @db.Decimal(12, 2)
  /// @kyselyType('pending' | 'completed' | 'failed')
  status             String
  provider           String
  provider_reference String?
  failure_reason     String?
  idempotency_key    String
  received_by        String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  completed_at       DateTime? @db.Timestamptz(6)

  @@unique([organization_id, id], map: "hotel_payments_org_id_uq")
  @@unique([organization_id, idempotency_key], map: "hotel_payments_idempotency_uq")
  @@index([organization_id, reservation_id], map: "hotel_payments_reservation_idx")
  @@map("hotel_payments")
}

model hotel_invoices {
  id              String    @id
  organization_id String
  number          String
  reservation_id  String
  /// @kyselyType('issued' | 'void')
  status          String    @default("issued")
  subtotal        Decimal   @db.Decimal(12, 2)
  tax             Decimal   @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  tax_rate        Decimal   @db.Decimal(5, 4)
  bill_to_name    String
  issued_by       String?
  issued_at       DateTime  @default(now()) @db.Timestamptz(6)
  voided_at       DateTime? @db.Timestamptz(6)
  void_reason     String?

  @@unique([organization_id, id], map: "hotel_invoices_org_id_uq")
  @@unique([organization_id, number], map: "hotel_invoices_number_uq")
  @@map("hotel_invoices")
}

model hotel_invoice_items {
  id              String   @id
  organization_id String
  invoice_id      String
  charge_id       String
  description     String
  service_date    DateTime @db.Date
  quantity        Int
  unit_price      Decimal  @db.Decimal(12, 2)
  amount          Decimal  @db.Decimal(12, 2)
  tax_amount      Decimal  @db.Decimal(12, 2)
  position        Int

  @@index([organization_id, invoice_id, position], map: "hotel_invoice_items_invoice_idx")
  @@map("hotel_invoice_items")
}

model hotel_housekeeping_tasks {
  id              String    @id
  organization_id String
  room_id         String
  reservation_id  String?
  /// @kyselyType('checkout_clean' | 'stayover' | 'deep_clean')
  kind            String
  /// @kyselyType('pending' | 'assigned' | 'in_progress' | 'completed' | 'inspected')
  status          String    @default("pending")
  /// @kyselyType('low' | 'normal' | 'high')
  priority        String    @default("normal")
  assignee_id     String?
  notes           String?
  due_date        DateTime  @db.Date
  started_at      DateTime? @db.Timestamptz(6)
  completed_at    DateTime? @db.Timestamptz(6)
  inspected_at    DateTime? @db.Timestamptz(6)
  inspected_by    String?
  created_by      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, id], map: "hotel_housekeeping_tasks_org_id_uq")
  @@index([organization_id, status, due_date], map: "hotel_housekeeping_tasks_status_idx")
  @@map("hotel_housekeeping_tasks")
}

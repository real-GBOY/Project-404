// app/hotel — maintenance tickets and their timeline. Mirrors migration
// 20260930120000_hotel_maintenance for Kysely type generation only.

model hotel_maintenance_tickets {
  id               String    @id
  organization_id  String
  number           String
  room_id          String
  title            String
  description      String?
  /// @kyselyType('low' | 'medium' | 'high' | 'urgent')
  priority         String    @default("medium")
  /// @kyselyType('open' | 'assigned' | 'in_progress' | 'resolved' | 'verified')
  status           String    @default("open")
  assignee_id      String?
  cost             Decimal   @default(0) @db.Decimal(12, 2)
  /// @kyselyType('none' | 'maintenance' | 'out_of_service')
  room_impact      String    @default("none")
  expected_back    DateTime? @db.Date
  resolution_notes String?
  reported_by      String?
  resolved_at      DateTime? @db.Timestamptz(6)
  verified_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, id], map: "hotel_maintenance_tickets_org_id_uq")
  @@unique([organization_id, number], map: "hotel_maintenance_tickets_number_uq")
  @@index([organization_id, status, priority], map: "hotel_maintenance_tickets_status_idx")
  @@index([organization_id, room_id], map: "hotel_maintenance_tickets_room_idx")
  @@map("hotel_maintenance_tickets")
}

model hotel_maintenance_events {
  id              String   @id
  organization_id String
  ticket_id       String
  seq             BigInt   @default(autoincrement())
  /// @kyselyType('reported' | 'assigned' | 'started' | 'note' | 'cost' | 'resolved' | 'reopened' | 'verified' | 'block_extended')
  kind            String
  body            String?
  actor_id        String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id, ticket_id, seq], map: "hotel_maintenance_events_ticket_idx")
  @@map("hotel_maintenance_events")
}

model hotel_public_bookings {
  organization_id String
  idempotency_key String
  request_hash    String
  reservation_id  String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@id([organization_id, idempotency_key], map: "hotel_public_bookings_pkey")
  @@map("hotel_public_bookings")
}

model hotel_rate_limits {
  bucket       String
  window_start DateTime @db.Timestamptz(6)
  hits         Int      @default(0)

  @@id([bucket, window_start], map: "hotel_rate_limits_pkey")
  @@index([window_start], map: "hotel_rate_limits_window_idx")
  @@map("hotel_rate_limits")
}

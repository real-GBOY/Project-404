model hotel_refunds {
  id                 String    @id
  organization_id    String
  reservation_id     String
  payment_id         String
  /// @kyselyType('cash' | 'card' | 'bank_transfer' | 'online')
  method             String
  amount             Decimal   @db.Decimal(12, 2)
  reason             String
  /// @kyselyType('pending' | 'completed' | 'failed')
  status             String
  provider           String
  provider_reference String?
  failure_reason     String?
  idempotency_key    String
  business_date      DateTime  @db.Date
  refunded_by        String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  completed_at       DateTime? @db.Timestamptz(6)

  @@unique([organization_id, id], map: "hotel_refunds_org_id_uq")
  @@unique([organization_id, idempotency_key], map: "hotel_refunds_idempotency_uq")
  @@index([organization_id, reservation_id], map: "hotel_refunds_reservation_idx")
  @@index([organization_id, payment_id], map: "hotel_refunds_payment_idx")
  @@index([organization_id, business_date], map: "hotel_refunds_business_date_idx")
  @@map("hotel_refunds")
}

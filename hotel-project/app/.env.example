# HotelOS staff app — build-time configuration (Vite inlines VITE_* at build).

# API base. Leave unset for same-origin `/api` (the Vite dev proxy locally, nginx on the VPS).
# Set to an absolute URL only when the app is served from another origin (e.g. Vercel).
# VITE_API_BASE=https://hotelos-api.example.com/api

# The public Hotel Transylvania website linked from the sidebar.
VITE_PUBLIC_SITE_URL=https://hotel-nayel.vercel.app

# Optional sign-in prefill for demo deployments only. Leave empty for real use.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Dev server (vite.config.ts) — not inlined into the bundle.
# HOTEL_APP_PORT=4600
# HOTEL_API_PROXY_TARGET=http://localhost:3200

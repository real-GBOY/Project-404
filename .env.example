# AURIC / Mizan — environment configuration.
# Copy to .env and adjust. Every value below is the built-in default.

NODE_ENV=development
AURIC_PORT=3000
AURIC_LOG_LEVEL=info

# ── PostgreSQL — the only datastore ─────────────────────────────────────────
# AURIC_DATABASE_URL is the schema owner (migrations, `provision-db`).
# The runtime connects with two lower-privilege roles for the multi-tenancy
# RLS backstop (docs/tenancy.md):
#   auric_app     — no BYPASSRLS; every tenant-scoped query is filtered by RLS
#   auric_system  — BYPASSRLS;    signup, provider webhooks, the outbox worker
# Both fall back to AURIC_DATABASE_URL when unset (single-role dev — RLS present
# but not enforced). Give the roles a login with:
#   AURIC_APP_DB_PASSWORD=... AURIC_SYSTEM_DB_PASSWORD=... npm run provision-db
AURIC_DATABASE_URL=postgres://postgres:postgres@localhost:5432/auric
# AURIC_APP_DATABASE_URL=postgres://auric_app:CHANGE_ME@localhost:5432/auric
# AURIC_SYSTEM_DATABASE_URL=postgres://auric_system:CHANGE_ME@localhost:5432/auric

# ── Auth ───────────────────────────────────────────────────────────────────
# Use a long random string per deployment. REQUIRED (non-default) in production.
#   openssl rand -base64 48
AURIC_JWT_SECRET=dev-only-insecure-change-me
AURIC_ACCESS_TOKEN_TTL=900          # seconds (15 min)
AURIC_REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# ── Localization ───────────────────────────────────────────────────────────
AURIC_DEFAULT_LOCALE=ar
AURIC_SUPPORTED_LOCALES=ar,en

# ── File storage ──────────────────────────────────────────────────────────
# Driver: `local` (disk, default — good for dev/tests) or `r2` (Cloudflare R2
# over its S3-compatible API). The presigned-upload flow works on both:
# `local` presigns its own authenticated loopback route, `r2` issues real S3
# presigned URLs the browser PUTs to directly. See core/files/README.md.
AURIC_FILE_STORAGE_DRIVER=local
AURIC_FILE_STORAGE_PATH=./storage/files

# Upload limits (both drivers).
AURIC_FILE_PRESIGN_TTL_SECONDS=900        # how long a presigned upload/download URL is valid
AURIC_FILE_MAX_UPLOAD_BYTES=26214400      # 25 MiB
# AURIC_FILE_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg   # empty = allow any

# ── Cloudflare R2 (only when AURIC_FILE_STORAGE_DRIVER=r2) ─────────────────
# Bucket `mizan-files` already exists in the project's Cloudflare account
# (location WEUR, default jurisdiction) with a CORS policy that allows PUT/GET/
# HEAD/DELETE from the Vercel frontend + localhost dev ports.
#
# The only thing left to create is an S3 API token:
#   Cloudflare dashboard → R2 → "Manage R2 API Tokens" → Create Account API token
#   → permission "Object Read & Write", scoped to bucket `mizan-files`.
# Copy the shown "Access Key ID" and "Secret Access Key" into the two blank
# values below. REQUIRED for the r2 driver:
# AURIC_R2_ACCOUNT_ID=6a7edde8430cc2563980926e6ae2dd0f
# AURIC_R2_ACCESS_KEY_ID=
# AURIC_R2_SECRET_ACCESS_KEY=
# AURIC_R2_BUCKET=mizan-files
# Optional:
# AURIC_R2_ENDPOINT=https://6a7edde8430cc2563980926e6ae2dd0f.r2.cloudflarestorage.com  # override the derived endpoint
# AURIC_R2_PUBLIC_BASE_URL=https://files.example.com             # custom domain / r2.dev for public files

# ── App identity (used in emails / notification templates) ─────────────────
AURIC_APP_NAME=AURIC
AURIC_APP_URL=http://localhost:3000

# ── Email (nodemailer) ─────────────────────────────────────────────────────
# Leave SMTP unset to use the dev JSON transport (logs the message instead of sending).
AURIC_MAIL_FROM=no-reply@auric.local
# AURIC_SMTP_URL=smtp://user:pass@smtp.example.com:587

# ── Outbox worker ──────────────────────────────────────────────────────────
AURIC_OUTBOX_POLL_INTERVAL_MS=2000
AURIC_OUTBOX_MAX_ATTEMPTS=5
AURIC_OUTBOX_BATCH_SIZE=20

# ── Optional ───────────────────────────────────────────────────────────────
# MIZAN_SEED_DEMO=true   # seed a fictional firm on boot (login: mahmoud.nayel@tawfikpartners.eg / demo-password-2026)

# ── AI / Mizan Copilot (mizan/backend/app/lawfirm/assistant) ───────────────
# Mizan-owned config (not AURIC Core). The provider/model are swappable so the
# same orchestration layer can target a different backend later.
#   AI_PROVIDER=groq   → OpenAI-compatible Chat Completions at api.groq.com
#   AI_PROVIDER=openai → api.openai.com (set OPENAI_API_KEY, adjust AI_MODEL)
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
# The key for the selected provider. GROQ_API_KEY for groq, OPENAI_API_KEY for openai.
GROQ_API_KEY=
# OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_MS=45000      # per upstream call
AI_MAX_TOOL_ITERATIONS=6         # agent-loop safety cap
AI_MAX_HISTORY_MESSAGES=24       # conversation turns sent upstream before older ones are dropped
# Keep the assistant on-topic. strict = a pre-flight check refuses off-topic
# requests (general knowledge, coding, unrelated content); prompt_only = rely on
# the system prompt alone; off = no restriction.
AI_SCOPE_ENFORCEMENT=strict

# AURIC Core — environment configuration
# Copy to .env and adjust. All values below are the built-in defaults.

NODE_ENV=development
AURIC_PORT=3000
AURIC_LOG_LEVEL=info

# PostgreSQL — the only database AURIC Core v0.1 uses.
AURIC_DATABASE_URL=postgres://postgres:postgres@localhost:5432/auric

# JWT signing. Use a long random string per deployment. REQUIRED in production.
AURIC_JWT_SECRET=dev-only-insecure-change-me
AURIC_ACCESS_TOKEN_TTL=900          # seconds (15 min)
AURIC_REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# Localization
AURIC_DEFAULT_LOCALE=ar
AURIC_SUPPORTED_LOCALES=ar,en

# File storage (local disk adapter for v0.1)
AURIC_FILE_STORAGE_DRIVER=local
AURIC_FILE_STORAGE_PATH=./storage/files

# App identity (used in emails and notification templates)
AURIC_APP_NAME=AURIC
AURIC_APP_URL=http://localhost:3000

# Email (nodemailer). Leave SMTP unset to use the dev JSON transport (logs instead of sending).
AURIC_MAIL_FROM=no-reply@auric.local
# AURIC_SMTP_URL=smtp://user:pass@smtp.example.com:587

# Outbox worker
AURIC_OUTBOX_POLL_INTERVAL_MS=2000
AURIC_OUTBOX_MAX_ATTEMPTS=5
AURIC_OUTBOX_BATCH_SIZE=20

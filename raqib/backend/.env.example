# Raqib backend — environment configuration.
# Copy to .env and adjust. This is a FULLY SEPARATE AURIC deployment/database
# from Mizan's and Atlas's — never point AURIC_DATABASE_URL at their databases.

NODE_ENV=development
AURIC_PORT=3300
AURIC_LOG_LEVEL=info

# ── PostgreSQL — Raqib's own database ─────────────────────────────────────
# Migrations run as this (schema-owner) URL. It must be allowed to
# CREATE EXTENSION btree_gist (a superuser on PostgreSQL 12 — see
# docs/architecture.md, "No double booking").
AURIC_DATABASE_URL=postgres://postgres:postgres@localhost:5432/raqib
# The runtime roles. Unset = fall back to the owner URL (RLS NOT enforced —
# local dev only). Production always sets both.
# AURIC_APP_DATABASE_URL=postgres://auric_app:CHANGE_ME@localhost:5432/raqib
# AURIC_SYSTEM_DATABASE_URL=postgres://auric_system:CHANGE_ME@localhost:5432/raqib

# ── Auth — Raqib's own secret; never reuse Mizan's or Atlas's ─────────────
AURIC_JWT_SECRET=dev-only-insecure-change-me
AURIC_ACCESS_TOKEN_TTL=900
AURIC_REFRESH_TOKEN_TTL=2592000

AURIC_DEFAULT_LOCALE=ar
AURIC_SUPPORTED_LOCALES=ar,en

# ── File storage (evidence photos/videos/PDFs, confidential attachments) ───
# local = disk (dev, tests). r2 = Cloudflare R2: the browser PUTs straight to a presigned URL, so the bucket's CORS must
# allow the web origin (GET/PUT/HEAD/DELETE, any header, expose ETag).
AURIC_FILE_STORAGE_DRIVER=local
# AURIC_R2_ACCOUNT_ID=
# AURIC_R2_BUCKET=raqib-files
# AURIC_R2_ACCESS_KEY_ID=
# AURIC_R2_SECRET_ACCESS_KEY=
# Raqib has its own bucket (raqib-files). To share one bucket between products instead, set a folder (key prefix) for each:
# AURIC_R2_KEY_PREFIX=raqib
AURIC_FILE_STORAGE_PATH=./storage/files
AURIC_FILE_PRESIGN_TTL_SECONDS=900
AURIC_FILE_MAX_UPLOAD_BYTES=524288000

AURIC_APP_NAME=Raqib
AURIC_APP_URL=http://localhost:4500

AURIC_MAIL_FROM=no-reply@raqib.example
# AURIC_SMTP_URL=smtp://user:pass@smtp.example.com:587

AURIC_OUTBOX_POLL_INTERVAL_MS=2000
AURIC_OUTBOX_MAX_ATTEMPTS=5
AURIC_OUTBOX_BATCH_SIZE=20

# Browser origins allowed cross-site (comma-separated; `*.host` = suffix match):
# the staff app when served from another origin.
# Empty = same-origin only (plus loopback dev origins).
AURIC_CORS_ORIGINS=

# ── Raqib ─────────────────────────────────────────────────────────────────
# Seed the fictional demo organization on boot ("true" / "false"). Never against real data.
# Days of past business the demo plays (1–365; default 120).
# RAQIB_DEMO_HISTORY_DAYS=120
RAQIB_SEED_DEMO=false
# Production refuses RAQIB_SEED_DEMO=true. A dedicated showcase deployment (never one with real data) can opt in:
# RAQIB_ALLOW_DEMO_IN_PRODUCTION=true

# Scheduled jobs (overdue visits and corrective actions) interval in ms; default 15 minutes.
# RAQIB_JOBS_INTERVAL_MS=900000
# Reverse proxies in front of the API (1 behind nginx). The rate limiter takes the
# client address this many X-Forwarded-For hops from the right. 0 = direct connections.
# RAQIB_TRUSTED_PROXY_HOPS=0
RAQIB_DEMO_HISTORY_DAYS=365
RAQIB_TRUSTED_PROXY_HOPS=0

# Report PDFs are made in the browser (Print > Save as PDF), so the server needs nothing for them.

# ── Security and data protection ───────────────────────────────────────────
# REQUIRED in production: master key for field encryption (national IDs, second-factor secrets). 32 random bytes, base64:
#   openssl rand -base64 32
# Back it up with the database password: losing it loses those values.
# RAQIB_DATA_KEY=
# Hold people at account set-up (required second factor, expired password). Default: on in production, off elsewhere.
# RAQIB_ENFORCE_ACCOUNT_POLICY=true
# Minutes an account stays locked after too many wrong passwords (the attempt limit is the organization's setting).
# RAQIB_LOCKOUT_MINUTES=15
# Days a decided account request keeps personal details before they are erased.
# RAQIB_ACCOUNT_REQUEST_RETENTION_DAYS=180


# ── Uploads ────────────────────────────────────────────────────────────────
# Optional antivirus daemon (clamd); every photo and PDF is scanned, and uploads fail closed if it is unreachable.
# RAQIB_CLAMAV_HOST=127.0.0.1
# RAQIB_CLAMAV_PORT=3310

# ── Operations ─────────────────────────────────────────────────────────────
# GET /api/metrics (Prometheus) needs this bearer token; unset = the endpoint answers 404.
# RAQIB_METRICS_TOKEN=
# Incoming webhook (Slack/Teams/PagerDuty-style) for server errors and failed jobs.
# RAQIB_ALERT_WEBHOOK_URL=

# Demo only: placeholder deduction values and shift hours so the whole workflow can be shown (NOT the client values)
# RAQIB_DEMO_SAMPLE_VALUES=true

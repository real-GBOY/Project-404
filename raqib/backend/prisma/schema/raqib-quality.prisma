model raqib_observations {
  id                  String   @id
  organization_id     String
  ref                 String
  /// @kyselyType('violation' | 'observation')
  kind                String
  project_id          String
  site_id             String
  visit_id            String?
  inspection_id       String?
  item_id             String?
  item_key            String?
  item_num            String?
  title_ar            String
  title_en            String
  note                String   @default("")
  /// @kyselyType('low' | 'medium' | 'high')
  severity            String
  repeat_count        Int      @default(0)
  reported_by         String?
  reported_by_name_ar String
  reported_by_name_en String
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, id], map: "raqib_observations_org_id_uq")
  @@unique([organization_id, ref], map: "raqib_observations_ref_uq")
  @@map("raqib_observations")
}

model raqib_corrective_actions {
  id                  String    @id
  organization_id     String
  ref                 String
  observation_id      String
  project_id          String
  title_ar            String
  title_en            String
  description         String    @default("")
  /// @kyselyType('low' | 'medium' | 'high')
  priority            String
  responsible_id      String
  due_date            DateTime  @db.Date
  /// @kyselyType('assigned' | 'in_progress' | 'quality_review' | 'returned' | 'closed')
  status              String    @default("assigned")
  round               Int       @default(1)
  created_by          String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  started_at          DateTime? @db.Timestamptz(6)
  submitted_at        DateTime? @db.Timestamptz(6)
  closed_at           DateTime? @db.Timestamptz(6)
  overdue_notified_at DateTime? @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, id], map: "raqib_corrective_actions_org_id_uq")
  @@unique([organization_id, ref], map: "raqib_corrective_actions_ref_uq")
  @@unique([organization_id, observation_id], map: "raqib_corrective_actions_obs_uq")
  @@map("raqib_corrective_actions")
}

model raqib_action_events {
  id              String   @id
  organization_id String
  action_id       String
  seq             BigInt   @default(autoincrement())
  /// @kyselyType('created' | 'started' | 'submitted' | 'comment' | 'returned' | 'closed' | 'reassigned')
  kind            String
  from_status     String?
  to_status       String?
  text            String?
  actor_id        String?
  actor_name_ar   String
  actor_name_en   String
  actor_role      String?
  actor_title_ar  String   @default("")
  actor_title_en  String   @default("")
  at              DateTime @default(now()) @db.Timestamptz(6)

  @@map("raqib_action_events")
}

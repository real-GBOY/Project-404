# Atlas RE OS backend — environment configuration.
# Copy to .env and adjust. This is a FULLY SEPARATE AURIC deployment/database
# from Mizan's — do not point AURIC_DATABASE_URL at Mizan's database.

NODE_ENV=development
AURIC_PORT=3100
AURIC_LOG_LEVEL=info

# ── PostgreSQL — Atlas's own database, separate from Mizan's ───────────────
AURIC_DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas
# AURIC_APP_DATABASE_URL=postgres://auric_app:CHANGE_ME@localhost:5432/atlas
# AURIC_SYSTEM_DATABASE_URL=postgres://auric_system:CHANGE_ME@localhost:5432/atlas

# ── Auth — Atlas's own secret; Atlas users are independent of Mizan's ──────
AURIC_JWT_SECRET=dev-only-insecure-change-me
AURIC_ACCESS_TOKEN_TTL=900
AURIC_REFRESH_TOKEN_TTL=2592000

AURIC_DEFAULT_LOCALE=en
AURIC_SUPPORTED_LOCALES=en,ar

# ── File storage (unit/contract/document uploads) ──────────────────────────
AURIC_FILE_STORAGE_DRIVER=local
AURIC_FILE_STORAGE_PATH=./storage/files
AURIC_FILE_PRESIGN_TTL_SECONDS=900
AURIC_FILE_MAX_UPLOAD_BYTES=26214400

AURIC_APP_NAME=Atlas RE OS
AURIC_APP_URL=http://localhost:3100

AURIC_MAIL_FROM=no-reply@atlas.local
# AURIC_SMTP_URL=smtp://user:pass@smtp.example.com:587

AURIC_OUTBOX_POLL_INTERVAL_MS=2000
AURIC_OUTBOX_MAX_ATTEMPTS=5
AURIC_OUTBOX_BATCH_SIZE=20

# Cross-origin access for atlas/web when served from a different origin
# (e.g. Vercel). Empty = same-origin only (plus loopback dev origins).
AURIC_CORS_ORIGINS=

# ── Optional ────────────────────────────────────────────────────────────────
# ATLAS_SEED_DEMO=true   # seed a fictional developer org on boot (see app/realestate/demo)

# Only used for `AURIC_TEST_DATABASE_URL`-gated integration tests.
# AURIC_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas_test

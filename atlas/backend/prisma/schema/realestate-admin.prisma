// app/realestate/admin — org-level settings. Team, Roles, Audit Logs and
// Notifications are thin adapters over Core (Identity/RBAC/Audit/
// Notifications) and need no tables of their own here. Product domain.

model realestate_org_settings {
  organization_id             String   @id
  reservation_hold_days       Int      @default(14)
  escalation_days             Int      @default(5)
  default_discount_pct        Decimal  @default(0) @db.Decimal(5, 2)
  ai_insight_refresh_minutes  Int      @default(60)
  updated_at                  DateTime @default(now()) @db.Timestamptz(6)

  @@map("realestate_org_settings")
}

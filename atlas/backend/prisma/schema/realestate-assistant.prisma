// app/realestate/assistant — AI Copilot ("Ask Atlas"). Real LLM (Groq ·
// openai/gpt-oss-120b via an OpenAI-compatible Chat Completions client) with
// tool-orchestration over the existing real-estate use cases, now on top of
// AURIC Core's generic assistant infrastructure (core/assistant/README.md).
// Product domain (not Core).
//
// The conversation store itself (`ai_conversations` / `ai_messages`) is
// Core-owned and has no Prisma model in this project, the same way Core's
// other baseline tables (users/organizations/roles/…) never do — see
// datasource.prisma and ../migrations/20260916120000_core_assistant. Only
// `realestate_ai_insights` (the dashboard insights banner — an unrelated
// Atlas-only feature) is modelled here.

model realestate_ai_insights {
  id               String    @id
  organization_id  String
  /// @kyselyType('dashboard' | 'feed')
  kind             String
  tag              String
  confidence       Decimal   @db.Decimal(4, 2)
  text             String
  detail           String
  cta              String
  target_route     String?
  dismissed_by     String?
  dismissed_at     DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, id], map: "realestate_ai_insights_org_id_uq")
  @@index([organization_id, kind], map: "realestate_ai_insights_kind_idx")
  @@map("realestate_ai_insights")
}

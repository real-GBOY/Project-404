# Admit backend — environment configuration.
# Copy to .env and adjust. This is a FULLY SEPARATE AURIC deployment/database
# from Mizan's and Atlas's — never point AURIC_DATABASE_URL at their databases.

NODE_ENV=development
AURIC_PORT=3400
AURIC_LOG_LEVEL=info

# ── PostgreSQL — Admit's own database ─────────────────────────────────────
# Migrations run as this (schema-owner) URL. It must be allowed to
# CREATE EXTENSION btree_gist (a superuser on PostgreSQL 12 — see
# docs/architecture.md, "No double booking").
AURIC_DATABASE_URL=postgres://postgres:postgres@localhost:5432/admit
# The runtime roles. Unset = fall back to the owner URL (RLS NOT enforced —
# local dev only). Production always sets both.
# AURIC_APP_DATABASE_URL=postgres://auric_app:CHANGE_ME@localhost:5432/admit
# AURIC_SYSTEM_DATABASE_URL=postgres://auric_system:CHANGE_ME@localhost:5432/admit

# ── Auth — Admit's own secret; never reuse Mizan's or Atlas's ─────────────
AURIC_JWT_SECRET=dev-only-insecure-change-me
AURIC_ACCESS_TOKEN_TTL=900
AURIC_REFRESH_TOKEN_TTL=2592000

AURIC_DEFAULT_LOCALE=en
AURIC_SUPPORTED_LOCALES=en

# ── File storage (guest documents, maintenance photos) ─────────────────────
# Production uses r2 (presigned uploads straight from the browser): AURIC_FILE_STORAGE_DRIVER=r2 plus AURIC_R2_ACCOUNT_ID,
# AURIC_R2_ACCESS_KEY_ID, AURIC_R2_SECRET_ACCESS_KEY, AURIC_R2_BUCKET (the bucket needs a CORS rule for the web origin).
AURIC_FILE_STORAGE_DRIVER=local
AURIC_FILE_STORAGE_PATH=./storage/files
AURIC_FILE_PRESIGN_TTL_SECONDS=900
AURIC_FILE_MAX_UPLOAD_BYTES=26214400

AURIC_APP_NAME=Admit
AURIC_APP_URL=http://localhost:4700

AURIC_MAIL_FROM=no-reply@admit.example
# AURIC_SMTP_URL=smtp://user:pass@smtp.example.com:587

AURIC_OUTBOX_POLL_INTERVAL_MS=2000
AURIC_OUTBOX_MAX_ATTEMPTS=5
AURIC_OUTBOX_BATCH_SIZE=20

# Browser origins allowed cross-site (comma-separated; `*.host` = suffix match):
# the staff app and the public booking site when served from other origins.
# Empty = same-origin only (plus loopback dev origins).
AURIC_CORS_ORIGINS=

# ── Admit ─────────────────────────────────────────────────────────────────
# Seed the demo organizer and events on boot ("true" / "false").
# Days of past business the demo plays (1–365; default 120).
# ADMIT_DEMO_HISTORY_DAYS=120
ADMIT_SEED_DEMO=false

# Scheduled jobs (booking hold expiry) interval in ms; default 15 minutes.
# ADMIT_JOBS_INTERVAL_MS=900000
# Reverse proxies in front of the API (1 behind nginx). The public API rate-limits by
# client address taken this many X-Forwarded-For hops from the right. 0 = direct connections.
# ADMIT_TRUSTED_PROXY_HOPS=0

# ── Tickets, links and the customer site ─────────────────────────────────────
# REQUIRED in production: the secret QR tokens and booking links are derived from. 32 random bytes, base64:
#   openssl rand -base64 32
# Back it up with the database password: losing it invalidates issued tickets and booking links.
# ADMIT_TICKET_KEY=
# Origin the customer web app is served from (links in emails) and the public API origin (QR images in emails).
ADMIT_PUBLIC_URL=http://localhost:4700
ADMIT_API_URL=http://localhost:3400
# Days a booking link stays valid (it also always works until the event has ended).
# ADMIT_ACCESS_LINK_DAYS=30
# Largest payment proof, bytes (default 10 MB).
# ADMIT_PROOF_MAX_BYTES=10485760
# Production refuses ADMIT_SEED_DEMO=true; a dedicated showcase deployment can opt in:
# ADMIT_ALLOW_DEMO_IN_PRODUCTION=true
# The picture every ticket QR opens when scanned with an ordinary phone (the QR holds this URL + #<ticket token>).
# ADMIT_QR_IMAGE_URL=https://i.postimg.cc/cCvLrpyG/Whats-App-Image-2026-10-10-at-2-27-41-PM.jpg

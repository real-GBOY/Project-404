<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{% block title %}{{ event_name }}{% endblock %}</title>
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
<style>
  body{margin:0;padding:0;width:100%!important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
  table{border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0}
  img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;display:block}
  a{color:#16140F}
  @media (max-width:480px){
    .px{padding-left:20px!important;padding-right:20px!important}
    .stack{display:block!important;width:100%!important}
    .qr-cell{padding:20px 20px 0!important;text-align:center!important}
    .qr-cell img{margin:0 auto!important}
    .h1{font-size:28px!important}
  }
  @media (prefers-color-scheme:dark){
    .bg-page{background:#1F1B16!important}
    .t-ink{color:#F4F1EB!important}
    .t-ink2{color:#CFC8BC!important}
    /* ticket + QR surfaces stay white on purpose */
  }
  [data-ogsc] .t-ink{color:#F4F1EB!important}
</style>
</head>
<body style="margin:0;padding:0;background:#F4F1EB;" class="bg-page">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{% block preheader %}{{ event_name }}{% endblock %}&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#F4F1EB" class="bg-page">
<tr><td align="center" style="padding:0;">
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;font-family:Helvetica,Arial,sans-serif;color:#16140F;">

  <!-- Header -->
  <tr><td class="px" style="padding:24px 32px;border-bottom:2px solid #16140F;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
      <td>{% if brand_logo_url %}<img src="{{ brand_logo_url }}" height="24" alt="{{ organizer_name }}" style="font-family:Helvetica,Arial,sans-serif;font-size:20px;font-weight:900;color:#16140F;">{% else %}<span style="font-size:22px;font-weight:900;letter-spacing:0.04em;">ADMIT<span style="color:#E0472B;">&#9679;</span></span>{% endif %}</td>
      <td align="right" class="t-ink2" style="font-size:12px;color:#4A463F;">Booking {{ booking_reference }}</td>
    </tr></table>
  </td></tr>

  <!-- Status pill -->
  <tr><td class="px" style="padding:32px 32px 8px;">
    <span style="display:inline-block;padding:4px 10px;border-radius:999px;background:{% block pill_bg %}#ECE8E1{% endblock %};color:{% block pill_fg %}#55504A{% endblock %};font-size:13px;font-weight:700;">{% block pill %}{% endblock %}</span>
  </td></tr>
  <tr><td class="px h1 t-ink" style="padding:8px 32px 0;font-size:34px;line-height:1.05;font-weight:800;color:#16140F;">{% block headline %}{% endblock %}</td></tr>

{% block content %}{% endblock %}

  <!-- Footer -->
  <tr><td class="px t-ink2" style="padding:28px 32px 40px;font-size:12px;line-height:1.6;color:#4A463F;">
    <div style="border-top:2px solid #16140F;padding-top:20px;">
      <strong class="t-ink" style="color:#16140F;">{{ organizer_name }}</strong>{% if support_email %} &middot; <a href="mailto:{{ support_email }}" style="color:#4A463F;">{{ support_email }}</a>{% endif %}<br>
      {% if policy_summary %}{{ policy_summary }}<br>{% endif %}
      <br>Sent by ADMIT<span style="color:#E0472B;">&#9679;</span> on behalf of the organizer.
    </div>
  </td></tr>

</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
</body>
</html>

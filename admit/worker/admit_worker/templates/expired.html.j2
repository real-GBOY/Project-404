{% extends "base.html.j2" %}
{% from "_macros.html.j2" import paragraph, outline_button with context %}
{% block title %}Your booking has expired - {{ event_name }}{% endblock %}
{% block preheader %}We didn't receive proof of payment in time, so the seats were released.{% endblock %}
{% block pill %}&mdash; Expired{% endblock %}
{% block headline %}Your booking has expired.{% endblock %}

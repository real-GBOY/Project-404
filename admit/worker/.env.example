# Admit email worker - environment configuration. Copy to .env.

# The Admit database as the auric_system role (BYPASSRLS): the worker serves every organizer and only ever touches
# admit_email_messages. Locally the owner URL works too.
ADMIT_WORKER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/admit

# "log" writes each message to ADMIT_WORKER_OUTBOX_DIR as an .eml file (development, demos). "smtp" delivers for real.
ADMIT_WORKER_TRANSPORT=log
ADMIT_WORKER_OUTBOX_DIR=./outbox
# smtp://user:pass@host:587 (STARTTLS when offered) or smtps://user:pass@host:465 (implicit TLS)
# ADMIT_WORKER_SMTP_URL=
ADMIT_WORKER_MAIL_FROM=Admit <tickets@admit.example>

ADMIT_WORKER_POLL_SECONDS=2
ADMIT_WORKER_BATCH_SIZE=10
# A claim older than this is treated as abandoned (the worker crashed) and the message is claimable again.
ADMIT_WORKER_LEASE_SECONDS=300
# Retry k waits BACKOFF * 2^(k-1) seconds; max attempts is per message (3 by default).
ADMIT_WORKER_BACKOFF_SECONDS=60
# ADMIT_WORKER_ID=
